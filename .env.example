APP_NAME="Prinx Tech"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Dar_es_Salaam
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=prinx_electronics
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="sales@prinx.co.tz"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

STORE_CURRENCY=TZS
STORE_COUNTRY=TZ
STORE_CONTACT_PHONE="+255 000 000 000"
STORE_CONTACT_EMAIL="sales@prinx.co.tz"
STORE_ADDRESS="Dodoma, Tanzania"
STORE_DESCRIPTION="Electronics products, accessories, installation, maintenance and repair services for homes, businesses and institutions."

# Inertia server-side rendering (public storefront pages)
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714
INERTIA_SSR_ENSURE_BUNDLE_EXISTS=true
INERTIA_SSR_PORT=13714
INERTIA_SSR_CLUSTER=false

# Google Merchant API v1
GOOGLE_MERCHANT_ENABLED=false
GOOGLE_MERCHANT_ACCOUNT_ID=
GOOGLE_MERCHANT_DATA_SOURCE_ID=
GOOGLE_MERCHANT_CONTENT_LANGUAGE=en
GOOGLE_MERCHANT_FEED_LABEL=TZ
GOOGLE_MERCHANT_CURRENCY=TZS
GOOGLE_MERCHANT_COUNTRY=TZ
GOOGLE_MERCHANT_SHIPPING_SERVICE="Standard delivery"
GOOGLE_MERCHANT_DEFAULT_SHIPPING_PRICE=0
GOOGLE_MERCHANT_LOCAL_INVENTORY_ENABLED=false
# Exact, case-sensitive physical-location store code from the linked Google Business Profile.
GOOGLE_MERCHANT_STORE_CODE=
GOOGLE_MERCHANT_CREDENTIALS_PATH=storage/app/private/google/service-account.json

# Optional AI product-description formatter
# Keep this key only on the server. Never expose it through VITE_ variables.
OPENAI_PRODUCT_FORMATTER_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Smart product recognition (photo + barcode fallback) and market price checks.
# Uses OPENAI_API_KEY. OPENAI_SEARCH_MODEL defaults to OPENAI_MODEL.
OPENAI_PRODUCT_INTELLIGENCE_ENABLED=true
OPENAI_SEARCH_MODEL=
# Barcode lookups: free UPCitemdb trial (100/day, no key). Set a key for a paid plan.
UPCITEMDB_ENABLED=true
UPCITEMDB_KEY=

# Automated ecommerce image optimization and SEO attribution.
# Product uploads become AVIF for the storefront plus a .merchant.webp sibling for Google Merchant compatibility.
MEDIA_DISK=public
MEDIA_AVIF_QUALITY=90
MEDIA_AVIF_EFFORT=6
MEDIA_WEBP_QUALITY=90
MEDIA_MAX_WIDTH=2000
MEDIA_MAX_HEIGHT=2000
MEDIA_IMAGE_CREATOR="Prinx Tech"
MEDIA_IMAGE_CREDIT="Prinx Tech"
# Only claim copyright when Prinx owns or is authorized to use the images.
MEDIA_COPYRIGHT_NOTICE=""
MEDIA_RIGHTS_URL="${APP_URL}/pages/terms"
STORE_LEGAL_NAME="Prinx Tech"
# Comma-separated official profiles, for example Facebook, Instagram, LinkedIn and Google Business Profile.
STORE_SOCIAL_PROFILES=
# Optional Search Console / Bing Webmaster verification tokens
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
